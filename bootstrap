#!/bin/sh
set -eu

REPO_URL="${MIRROR_REPO_URL:-https://github.com/joshuacox/mirror.git}"
PREFIX="${PREFIX:-/usr/local}"

TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'mirror')
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM

echo "==> Cloning mirror repository..."
git clone --depth=1 "$REPO_URL" "$TMP_DIR/mirror"
cd "$TMP_DIR/mirror"

if [ ! -w "$PREFIX/bin" ] && [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    echo "==> Privilege escalation required to install to $PREFIX/bin"
    sudo make install PREFIX="$PREFIX"
  else
    echo "Error: Cannot write to $PREFIX/bin and 'sudo' is unavailable." >&2
    echo "Hint: Try installing to your user directory with: PREFIX=\$HOME/.local ./bootstrap" >&2
    exit 1
  fi
else
  make install PREFIX="$PREFIX"
fi

echo "==> Successfully installed mirror to $PREFIX/bin/mirror"
